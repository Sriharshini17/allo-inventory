generator client {

  provider = "prisma-client-js"

}

datasource db {

  provider = "postgresql"

  url      = env("DATABASE_URL")

}

model Product {

  id         Int      @id @default(autoincrement())

  name       String

  warehouse  String

  stock      Int

  price      Int

  image      String

  createdAt  DateTime @default(now())

}

model Reservation {

  id           Int      @id @default(autoincrement())

  productName  String

  warehouse    String

  status       String

  createdAt    DateTime @default(now())

}
model user {

  id        Int      @id @default(autoincrement())

  email     String   @unique

  password  String

  role      String

  createdAt DateTime @default(now())

}